+/// Reads the big-endian 256-bit value at `bytes`, which need not be aligned, as little-endian limbs.
+#[inline(always)]
+unsafe fn read_be_u256(bytes: *const u8) -> [u64; 4] {
+    [load_be_u64(bytes.add(24)), load_be_u64(bytes.add(16)), load_be_u64(bytes.add(8)), load_be_u64(bytes)]
+}
+
+/// Writes little-endian limbs as a big-endian 256-bit value at `bytes`, which need not be aligned.
+#[inline(always)]
+unsafe fn write_be_u256(bytes: *mut u8, limbs: &[u64; 4]) {
+    store_be_u64(bytes, limbs[3]);
+    store_be_u64(bytes.add(8), limbs[2]);
+    store_be_u64(bytes.add(16), limbs[1]);
+    store_be_u64(bytes.add(24), limbs[0]);
+}
+
+/// One `ld` and one `rev8`: ZisK executes both, while the rv64ima target would read byte by byte.
+#[inline(always)]
+unsafe fn load_be_u64(bytes: *const u8) -> u64 {
+    #[cfg(zisk_guest)]
+    {
+        let value: u64;
+        core::arch::asm!(
+            "ld {v}, 0({p})",
+            // rev8 {v}, {v}
+            ".insn i 0x13, 5, {v}, {v}, 0x6b8",
+            p = in(reg) bytes,
+            v = out(reg) value,
+            options(pure, readonly, nostack, preserves_flags),
+        );
+        value
+    }
+    #[cfg(not(zisk_guest))]
+    {
+        u64::from_be_bytes(core::ptr::read_unaligned(bytes as *const [u8; 8]))
+    }
+}
+
+#[inline(always)]
+unsafe fn store_be_u64(bytes: *mut u8, value: u64) {
+    #[cfg(zisk_guest)]
+    core::arch::asm!(
+        // rev8 {t}, {v}
+        ".insn i 0x13, 5, {t}, {v}, 0x6b8",
+        "sd {t}, 0({p})",
+        p = in(reg) bytes,
+        v = in(reg) value,
+        t = out(reg) _,
+        options(nostack, preserves_flags),
+    );
+    #[cfg(not(zisk_guest))]
+    core::ptr::write_unaligned(bytes as *mut [u8; 8], value.to_be_bytes());
+}
